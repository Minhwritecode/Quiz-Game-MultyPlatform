default_platform(:android)

platform :android do
  desc "Build the signed release bundle"
  lane :build_release do
    gradle(task: "clean", project_dir: "android")
    sh("flutter", "build", "appbundle", "--release", "--build-name=#{ENV.fetch('BUILD_NAME', '0.1.0')}", "--build-number=#{ENV.fetch('BUILD_NUMBER', '1')}")
  end

  desc "Run the Android release smoke lane without publishing"
  lane :verify_release do
    sh("flutter", "build", "apk", "--release")
  end
end

