EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Local development works without release services. Set these only when provisioned.
APP_VARIANT=development
EAS_PROJECT_ID=
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
EXPO_PUBLIC_RELEASE_POLICY_URL=
# SENTRY_AUTH_TOKEN belongs in EAS/GitHub secrets, never EXPO_PUBLIC_*.
# AI keys and the Supabase service-role key belong only in Edge Function secrets.
