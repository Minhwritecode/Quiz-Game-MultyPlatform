EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Local development works without release services. Set these only when provisioned.
APP_VARIANT=development
EAS_PROJECT_ID=
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
EXPO_PUBLIC_RELEASE_POLICY_URL=
# Optional publishable key for Stripe client elements (safe for client bundle):
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SENTRY_AUTH_TOKEN belongs in EAS/GitHub secrets, never EXPO_PUBLIC_*.
# Server-only secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, GEMINI_API_KEY, OPENAI_COMPAT_*)
# MUST NEVER be prefixed with EXPO_PUBLIC_. Put them in `supabase/.env.local` (see `supabase/.env.example`)
# or deploy them to Supabase Cloud via: `supabase secrets set --env-file supabase/.env.local`
