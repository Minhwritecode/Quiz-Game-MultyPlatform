{
  "cli": {
    "version": "27.7.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "android": { "image": "ubuntu-26.04-jdk-17-ndk-r27b-sdk-58" },
      "ios": { "image": "macos-tahoe-26.6-xcode-27.2" },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "APP_VARIANT": "preview"
      },
      "android": {
        "image": "ubuntu-26.04-jdk-17-ndk-r27b-sdk-58",
        "buildType": "apk"
      },
      "ios": { "image": "macos-tahoe-26.6-xcode-27.2" }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": { "simulator": true }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "image": "ubuntu-26.04-jdk-17-ndk-r27b-sdk-58",
        "buildType": "app-bundle"
      },
      "ios": { "image": "macos-tahoe-26.6-xcode-27.2" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
