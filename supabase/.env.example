# =============================================================================
# Supabase Edge Functions Secrets Template (`supabase/.env.local`)
# Copy this file to `supabase/.env.local` (gitignored) for local Edge Functions
# or push to Supabase Cloud with: `supabase secrets set --env-file supabase/.env.local`
# =============================================================================

# 1. Stripe Billing & Checkout (`supabase/functions/billing-checkout`)
# Get your test/live secret key from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# 2. Primary AI Provider — Google Gemini (`generate-questions` & `rag-ingest`)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# 3. Optional Self-Hosted / OpenAI-Compatible Provider (OpenAI, Ollama, vLLM, LM Studio)
# Set AI_PROVIDER=openai-compatible to route generation & embeddings here instead of Gemini
AI_PROVIDER=gemini
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=qwen2.5:7b
OPENAI_COMPAT_EMBED_MODEL=nomic-embed-text
