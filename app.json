{
  "expo": {
    "name": "Papyrus",
    "slug": "papyrus",
    "version": "0.2.0",
    "orientation": "default",
    "scheme": "papyrus",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      ["expo-image-picker", {"cameraPermission": "Allow Papyrus to scan your study notes on this device.", "photosPermission": "Allow Papyrus to read selected study material.", "microphonePermission": false}],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "web": {
      "output": "single"
    },
    "android": {
      "package": "com.papyrus.quizclash"
    },
    "ios": {
      "bundleIdentifier": "com.papyrus.quizclash"
    }
  }
}
